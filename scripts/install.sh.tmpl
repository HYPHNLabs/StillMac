#!/bin/sh
set -eu
PATH='/usr/bin:/bin:/usr/sbin:/sbin'
export PATH

validate_version() {
    v=$1
    case "$v" in v*) ;; *) return 1 ;; esac
    rest=${v#v}
    oldifs=$IFS; IFS=.; set -- $rest; IFS=$oldifs
    [ "$#" -eq 3 ] || return 1
    for part in "$@"; do
        [ -n "$part" ] || return 1
        case "$part" in *[!0-9]*) return 1 ;; esac
        case "$part" in 0|[1-9]*) ;; *) return 1 ;; esac
    done
}
path_identity() {
    if [ "$(uname -s)" = Darwin ]; then
        stat -f '%d:%i:%u:%Lp' -- "$1"
    else
        stat -c '%d:%i:%u:%a' -- "$1"
    fi
}
secure_component() {
    p=$1 expected_uid=$2
    [ -d "$p" ] && [ ! -L "$p" ] || return 1
    identity=$(path_identity "$p") || return 1
    oldifs=$IFS; IFS=:; set -- $identity; IFS=$oldifs
    [ "$#" -eq 4 ] || return 1
    [ "$3" = "$expected_uid" ] || return 1
    mode=$4
    case "$mode" in *[!0-9]*|'') return 1 ;; esac
    [ "$((mode % 100))" -eq 0 ] || return 1
}
VERSION=${STILLMAC_VERSION:-v0.1.0}; OWNER_REPO=${STILLMAC_REPO:-HYPHNLabs/StillMac}
BASE=${STILLMAC_DOWNLOAD_BASE:-"https://github.com/$OWNER_REPO/releases/download/$VERSION"}
TRUSTED_MANIFEST_SHA256='@TRUSTED_MANIFEST_SHA256@'
fail(){ printf '%s\n' "StillMac installer: $*" >&2; exit 1; }
case "$TRUSTED_MANIFEST_SHA256" in
  [0-9a-fA-F][0-9a-fA-F]*) [ "${#TRUSTED_MANIFEST_SHA256}" -eq 64 ] || fail 'installer is not release-activated' ;;
  *) fail 'installer is not release-activated' ;;
esac
[ "$(uname -s)" = Darwin ] || fail 'StillMac supports macOS only'
case "$(uname -m)" in arm64) target=arm64;; x86_64) target=amd64;; *) fail 'unsupported macOS architecture';; esac
[ "$(id -u)" -ne 0 ] || fail 'do not run installer as root or sudo'
validate_version "$VERSION" || fail 'invalid version'
case "$HOME" in /*) ;; *) fail 'HOME must be absolute';; esac
uid=$(id -u); secure_component "$HOME" "$uid" || fail 'HOME is unsafe'
local="$HOME/.local"; bin="$local/bin"
for p in "$local" "$bin"; do
  if [ -e "$p" ] || [ -L "$p" ]; then secure_component "$p" "$uid" || fail 'destination path component is unsafe'; else mkdir "$p" || fail 'cannot create destination directory'; chmod 700 "$p"; secure_component "$p" "$uid" || fail 'created destination directory is unsafe'; fi
done
home_id=$(path_identity "$HOME"); local_id=$(path_identity "$local"); bin_id=$(path_identity "$bin")
TMP=$(mktemp -d "${TMPDIR:-/tmp}/stillmac-install.XXXXXXXX") || fail 'cannot create private temporary directory'; trap 'rm -rf -- "$TMP"' EXIT INT TERM
archive_name="stillmac-$VERSION-darwin-$target.tar.gz"; archive="$TMP/$archive_name"; manifest="$TMP/SHA256SUMS"
curl --fail --location --silent --show-error "$BASE/$archive_name" -o "$archive" || fail 'archive download failed'
curl --fail --location --silent --show-error "$BASE/SHA256SUMS" -o "$manifest" || fail 'manifest download failed'
manifest_actual=$(shasum -a 256 "$manifest" | awk '{print $1}')
[ "$manifest_actual" = "$TRUSTED_MANIFEST_SHA256" ] || fail 'release manifest pin mismatch'
expected=$(awk -v version="$VERSION" -v name="$archive_name" 'BEGIN{n=0;found=0;bad=0}{if(NF!=2){bad=1;next};h=$1;f=$2;if(h !~ /^[0-9A-Fa-f][0-9A-Fa-f]*$/ || length(h)!=64 || f !~ /^\*?[A-Za-z0-9._-]+$/){bad=1};n++;if(f==name||f=="*"name){found++;hash=h}}END{if(bad||n!=2||found!=1)exit 1;print hash}' "$manifest") || fail 'manifest is malformed'
actual=$(shasum -a 256 "$archive" | awk '{print $1}'); [ "$actual" = "$expected" ] || fail 'archive checksum mismatch'
stage="$TMP/stage"; mkdir "$stage"; LC_ALL=C tar -tvzf "$archive" > "$TMP/list" || fail 'cannot inspect archive'
awk 'BEGIN{n=0;bad=0}{n++;if($1!~/^-/||$NF!="stillmac"||$0~/[[:space:]]link to[[:space:]]/)bad=1}END{if(bad||n!=1)exit 1}' "$TMP/list" || fail 'unsafe archive member type or set'
LC_ALL=C tar -xzf "$archive" -C "$stage" || fail 'archive extraction failed'; [ -f "$stage/stillmac" ] && [ ! -L "$stage/stillmac" ] || fail 'extracted binary is not regular'
[ ! -L "$bin/stillmac" ] || fail 'destination binary is a symlink'; [ ! -e "$bin/stillmac" ] || [ -f "$bin/stillmac" ] || fail 'destination binary is not regular'
doctor_data="$TMP/doctor-data"; "$stage/stillmac" doctor --data-dir "$doctor_data" >/dev/null || fail 'staged binary failed doctor'
[ "$(path_identity "$HOME")" = "$home_id" ] && [ "$(path_identity "$local")" = "$local_id" ] && [ "$(path_identity "$bin")" = "$bin_id" ] || fail 'destination path changed during install'
new=$(mktemp "$bin/.stillmac.new.XXXXXXXX") || fail 'cannot create destination staging file'; cp "$stage/stillmac" "$new" || { rm -f "$new"; fail 'cannot stage destination binary'; }; chmod 755 "$new"
if [ -e "$bin/stillmac" ]; then mv "$bin/stillmac" "$new.old" || { rm -f "$new"; fail 'cannot preserve existing binary'; }; fi
if mv "$new" "$bin/stillmac"; then rm -f "$new.old"; else rm -f "$new"; [ -e "$new.old" ] && mv "$new.old" "$bin/stillmac"; fail 'cannot install binary'; fi
printf 'installed %s\n' "$bin/stillmac"
